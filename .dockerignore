# Version control
.git
.gitignore

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.mypy_cache
.venv

# Django dev artifacts
backend/logs/
backend/staticfiles/
backend/mediafiles/
backend/*.sqlite3
backend/staticfiles_dev/

# Node / frontend dev artifacts
frontend/node_modules/
frontend/dist/

# Docker / compose files (not needed in image)
docker-compose*.yml
.env*

# Docs
backend/docs/
backend/site/

# Editor / OS
.vscode/
**/.DS_Store
