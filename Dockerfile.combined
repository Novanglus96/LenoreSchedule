#####################
# Stage 1: Vue build #
#####################
FROM node:lts-alpine AS frontend-build

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

#########################
# Stage 2: Python wheels #
#########################
FROM python:3.11.4-slim-bookworm AS python-build

WORKDIR /usr/src/app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends gcc

RUN pip install --upgrade pip
COPY backend/requirements.txt .
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /usr/src/app/wheels -r requirements.txt

######################
# Stage 3: Final image #
######################
FROM python:3.11.4-slim-bookworm

LABEL maintainer="John Adams"

# Create app user
RUN addgroup --system app && adduser --system --group app

# App directories
ENV HOME=/home/app
ENV APP_HOME=/home/app/web
RUN mkdir -p $APP_HOME/staticfiles $APP_HOME/mediafiles
WORKDIR $APP_HOME

# Install system packages: nginx, supervisord, netcat
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    netcat-openbsd \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY --from=python-build /usr/src/app/wheels /wheels
COPY --from=python-build /usr/src/app/requirements.txt .
RUN pip install --upgrade pip && pip install --no-cache /wheels/*

# Copy Django backend
COPY backend/ $APP_HOME/

# Copy Vue build output
COPY --from=frontend-build /app/dist /app/dist

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

# Copy supervisord config
COPY docker/supervisord.conf /etc/supervisord.conf

# Copy and configure entrypoint
COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Ownership for app user (nginx runs as root, gunicorn as app)
RUN chown -R app:app $APP_HOME

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
